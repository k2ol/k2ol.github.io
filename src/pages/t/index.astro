				--card-bg: rgba(0, 0, 0, 0.04);
				--card-hover: rgba(0, 0, 0, 0.09);
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #111111;
					--fg: #f5f5f5;
					--muted: #9a9a9a;
					--card-bg: rgba(255, 255, 255, 0.07);
					--card-hover: rgba(255, 255, 255, 0.14);
				}
			}
			body {
				margin: 0;
				min-height: 100vh;
				background: var(--bg);
				color: var(--fg);
				font-family: system-ui, -apple-system, 'Segoe UI', 'Noto Sans TC', sans-serif;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			main {
				width: min(90vw, 34rem);
				padding: 2rem 0;
			}
			h1 {
				font-size: 1.9rem;
				margin: 0 0 0.4rem;
			}
			.lead {
				color: var(--muted);
				margin: 0 0 1.6rem;
			}
			nav ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.8rem;
			}
			nav a {
				display: block;
				padding: 1rem 1.2rem;
				border-radius: 1rem;
				background: var(--card-bg);
				color: inherit;
				text-decoration: none;
				transition: background 0.2s;
			}
			nav a:hover {
				background: var(--card-hover);
			}
			nav .name {
				font-size: 1.15rem;
				font-weight: 700;
			}
			nav .desc {
				margin-top: 0.25rem;
				color: var(--muted);
				font-size: 0.95rem;
			}
			footer {
				margin-top: 1.8rem;
				font-size: 0.9rem;
			}
			footer a {
				color: var(--muted);
			}
		</style>
